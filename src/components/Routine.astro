---
import Stars from './Stars.astro'
import BuyButton from './BuyButton.astro'
const { steps } = Astro.props
---
<ol class="routine">
  {steps.map((p, i) => (
    <li class="rstep">
      <div class="rstep__num">{i + 1}</div>
      <img
        class="rstep__img"
        src={p.image}
        alt={p.name}
        width="180"
        height="180"
        loading="lazy"
        decoding="async"
      />
      <div class="rstep__body">
        <p class="rstep__step">
          {p.step}
          {p.when && <span class="pill pill--when">{p.when}</span>}
        </p>
        <h3 class="rstep__name">{p.name}</h3>
        <div class="litem__meta">
          {p.rating != null && <Stars value={p.rating} />}
          {p.reviews != null && <span>{p.reviews.toLocaleString()} ratings</span>}
          {p.badge && <span class="badge">{p.badge}</span>}
          {p.bestFor && <span class="pill">Best for: {p.bestFor}</span>}
        </div>
        {p.blurb && <p class="litem__blurb">{p.blurb}</p>}
        <BuyButton amazon={p.amazon} yesstyle={p.yesstyle} />
      </div>
    </li>
  ))}
</ol>
